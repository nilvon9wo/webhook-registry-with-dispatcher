# Webhook Registry + Dispatcher — manual API requests.
# Works with the JetBrains HTTP Client and the VS Code "REST Client" extension.
# Start the server first: `npm run dev`

@baseUrl = http://localhost:3000

### Health
GET {{baseUrl}}/health

### Create a subscription
# @name createSubscription
POST {{baseUrl}}/subscriptions
Content-Type: application/json

{
  "eventType": "order.created",
  "targetUrl": "https://example.com/webhooks/orders"
}

### List subscriptions
GET {{baseUrl}}/subscriptions

### List subscriptions filtered by event type
GET {{baseUrl}}/subscriptions?eventType=order.created

### Get one subscription
GET {{baseUrl}}/subscriptions/{{createSubscription.response.body.id}}

### Replace a subscription
PUT {{baseUrl}}/subscriptions/{{createSubscription.response.body.id}}
Content-Type: application/json

{
  "eventType": "order.updated",
  "targetUrl": "https://example.com/webhooks/orders-v2"
}

### Delete a subscription
DELETE {{baseUrl}}/subscriptions/{{createSubscription.response.body.id}}

### Publish an event
# @name publishEvent
POST {{baseUrl}}/events
Content-Type: application/json

{
  "type": "order.created",
  "data": { "orderId": "12345" }
}

### Get the published event
GET {{baseUrl}}/events/{{publishEvent.response.body.id}}

### List all deliveries
GET {{baseUrl}}/deliveries

### Deliveries for the published event
GET {{baseUrl}}/deliveries?eventId={{publishEvent.response.body.id}}

### Deliveries by status
GET {{baseUrl}}/deliveries?status=failed

### Get one delivery
GET {{baseUrl}}/deliveries/REPLACE_WITH_DELIVERY_ID

### Validation error example (missing targetUrl)
POST {{baseUrl}}/subscriptions
Content-Type: application/json

{
  "eventType": "order.created"
}
