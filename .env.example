# Copy to `.env` for local development. Never commit `.env`.
# Every value below is optional; the shown value is the built-in default.

# --- Runtime ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Log rendering: auto = coloured, human-readable lines on a TTY, JSON when piped
# or redirected. Force with `json` (the machine contract) or `pretty`.
LOG_FORMAT=auto

# --- Persistence: choose ONE -----------------------------------------------
# memory (default): in-process store. Zero setup, no AWS. NOTHING SURVIVES A
#   RESTART. Intended for local dev, the test suite, and CI. The startup logs
#   always emit a `config.warning` for this (louder under NODE_ENV=production).
PERSISTENCE=memory
#
# dynamodb: durable AWS DynamoDB (tables from infrastructure/cloudformation.yaml).
#   To use it: comment out `PERSISTENCE=memory` above, then uncomment BOTH lines
#   below. Needs AWS credentials on the SDK provider chain — simplest is
#   `aws sso login --profile webhook-challenge` plus the AWS_PROFILE line.
# PERSISTENCE=dynamodb
# AWS_PROFILE=webhook-challenge

AWS_REGION=eu-central-1
# Point at a local DynamoDB (docker: amazon/dynamodb-local) instead of real AWS:
# DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_SUBSCRIPTIONS_TABLE=webhook-registry-subscriptions
DYNAMODB_EVENTS_TABLE=webhook-registry-events
DYNAMODB_DELIVERIES_TABLE=webhook-registry-deliveries
# --------------------------------------------------------------------------

# --- HTTP ---
MAX_REQUEST_BODY_BYTES=1048576

# --- Delivery / retry policy ---
WEBHOOK_TIMEOUT_MS=5000
MAX_DELIVERY_ATTEMPTS=5
RETRY_BASE_DELAY_MS=500
RETRY_MAX_DELAY_MS=30000

# --- Recovery sweeper ---
# RECOVERY_INTERVAL_MS=0 disables the background sweeper.
RECOVERY_INTERVAL_MS=60000
STUCK_DELIVERING_THRESHOLD_MS=60000
RECOVERY_BATCH_LIMIT=100

# --- Security ---
# Allow plain http:// webhook targets (needed for local end-to-end testing).
ALLOW_INSECURE_TARGET_URLS=false
# Reject targets resolving to loopback/private/link-local/metadata addresses.
SSRF_GUARD_ENABLED=true
