# Copy to `.env` for local development. Never commit `.env`.
# Every value below is optional; the shown value is the built-in default.

# --- Runtime ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Log rendering: auto = coloured, human-readable lines on a TTY, JSON when piped
# or redirected. Force with `json` (the machine contract) or `pretty`.
LOG_FORMAT=auto

# --- Persistence: choose ONE backend -------------------------------------------
# A. memory (default): in-process store. Zero setup, no AWS. NOTHING SURVIVES A
#    RESTART. For local dev, the test suite, CI. Startup always logs a
#    `config.warning` for this (louder under NODE_ENV=production).
PERSISTENCE=memory

# B. dynamodb against a LOCAL DynamoDB (Docker) — no AWS account. Uncomment
#    these four and set PERSISTENCE=dynamodb above. The AWS_ACCESS_KEY_ID /
#    AWS_SECRET_ACCESS_KEY are dummy values the SDK requires even for a local
#    endpoint (any non-empty string). Start the DB with
#    `docker compose -f docker-compose.dynamodb-local.yml up -d`, create the
#    tables with `npm run provision:dynamo`. (Or run the whole stack in Docker:
#    `docker compose up --build` / `npm run stack:up`.)
# DYNAMODB_ENDPOINT=http://localhost:8000
# AWS_ACCESS_KEY_ID=local
# AWS_SECRET_ACCESS_KEY=local

# C. dynamodb against REAL AWS. Uncomment AWS_PROFILE (or provide real
#    AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY), set PERSISTENCE=dynamodb, and
#    deploy infrastructure/cloudformation.yaml. `aws sso login` first if using SSO.
# AWS_PROFILE=webhook-challenge

# Shared by B and C:
AWS_REGION=eu-central-1
DYNAMODB_SUBSCRIPTIONS_TABLE=webhook-registry-subscriptions
DYNAMODB_EVENTS_TABLE=webhook-registry-events
DYNAMODB_DELIVERIES_TABLE=webhook-registry-deliveries

# Note: AWS_PROFILE / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are read by the
# AWS SDK's credential provider chain, not by this app's config. Never commit
# real values.
# --------------------------------------------------------------------------

# --- HTTP ---
MAX_REQUEST_BODY_BYTES=1048576

# --- Delivery / retry policy ---
WEBHOOK_TIMEOUT_MS=5000
MAX_DELIVERY_ATTEMPTS=5
RETRY_BASE_DELAY_MS=500
RETRY_MAX_DELAY_MS=30000

# --- Recovery sweeper ---
# RECOVERY_INTERVAL_MS=0 disables the background sweeper.
RECOVERY_INTERVAL_MS=60000
STUCK_DELIVERING_THRESHOLD_MS=60000
RECOVERY_BATCH_LIMIT=100

# --- Security ---
# Allow plain http:// webhook targets (needed for local end-to-end testing).
ALLOW_INSECURE_TARGET_URLS=false
# Reject targets resolving to loopback/private/link-local/metadata addresses.
SSRF_GUARD_ENABLED=true
