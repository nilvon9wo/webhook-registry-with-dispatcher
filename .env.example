# Copy to `.env` for local development. Never commit `.env`.
# Every value below is optional; the shown value is the built-in default.

# --- Runtime ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Persistence ---
# memory   = in-process store (default; no AWS needed)
# dynamodb = AWS DynamoDB via the AWS SDK (uses the standard credential chain)
PERSISTENCE=memory

AWS_REGION=eu-central-1
# Uncomment to point at DynamoDB Local instead of real AWS:
# DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_SUBSCRIPTIONS_TABLE=webhook-registry-subscriptions
DYNAMODB_EVENTS_TABLE=webhook-registry-events
DYNAMODB_DELIVERIES_TABLE=webhook-registry-deliveries

# --- HTTP ---
MAX_REQUEST_BODY_BYTES=1048576

# --- Delivery / retry policy ---
WEBHOOK_TIMEOUT_MS=5000
MAX_DELIVERY_ATTEMPTS=5
RETRY_BASE_DELAY_MS=500
RETRY_MAX_DELAY_MS=30000

# --- Recovery sweeper ---
# RECOVERY_INTERVAL_MS=0 disables the background sweeper.
RECOVERY_INTERVAL_MS=60000
STUCK_DELIVERING_THRESHOLD_MS=60000
RECOVERY_BATCH_LIMIT=100

# --- Security ---
# Allow plain http:// webhook targets (needed for local end-to-end testing).
ALLOW_INSECURE_TARGET_URLS=false
# Reject targets resolving to loopback/private/link-local/metadata addresses.
SSRF_GUARD_ENABLED=true
