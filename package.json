{
  "name": "webhook-registry-dispatcher",
  "version": "1.0.0",
  "description": "Webhook Registry + Dispatcher technical challenge",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "inbox": "tsx scripts/webhook-inbox.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:all",
    "cfn:lint": "cfn-lint infrastructure/cloudformation.yaml",
    "cfn:validate": "aws cloudformation validate-template --template-body file://infrastructure/cloudformation.yaml"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "oxlint": "1.80.0",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1119.0",
    "@aws-sdk/lib-dynamodb": "3.1116.0"
  }
}
