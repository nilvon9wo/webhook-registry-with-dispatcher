# Temporary / Backup Files
# ============================================================

*.tmp
*.temp
*.swp
*.swo
*.bak
*.orig

# ============================================================
# Docker / Local Development
# ============================================================

# Local Docker volumes/configuration
.docker/

# ============================================================
# AWS / Infrastructure
# ============================================================

# SAM CLI
.aws-sam/

# Serverless Framework
.serverless/

# Terraform state, in case Terraform is experimented with locally.
# CloudFormation templates themselves should NOT be ignored.
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*

# ============================================================
# Generated / Local Development Artifacts
# ============================================================

tmp/
temp/

# Local DynamoDB data, if DynamoDB Local is used
.dynamodb/

# LocalStack state
.localstack/

# ============================================================
# Challenge / Submission Artifacts
# ============================================================

# Generated ZIP archives should not normally be committed
*.zip
